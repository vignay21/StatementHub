# Supabase configuration for StatementHub
# Copy this file to .streamlit/secrets.toml and fill in your Supabase project details.
# You can find these at: https://supabase.com/dashboard/project/_/settings/api

[supabase]
url = "https://your-project-id.supabase.co"
key = "your-supabase-secret-service-role-key"
